class Student:
    def __init__(self, name, marks):
        self.name = name
        self.__marks = marks

    def get_marks(self):
        return self.__marks

    def set_marks(self, marks):
        if 0 <= marks <= 100:
            self.__marks = marks
        else:
            print("Invalid marks")

s = Student("Aishwarya", 85)

print(s.name)
print(s.get_marks())

s.set_marks(95)
print(s.get_marks())
